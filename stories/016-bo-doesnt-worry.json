{
  "id": "016-bo-doesnt-worry",
  "title": "Bo Doesn't Worry",
  "lesson": "Don't worry. You are cared for.",
  "scene": "meadow",
  "music": {
    "key": "D",
    "bpm": 88,
    "seed": 14,
    "mood": "calm"
  },
  "characters": {
    "luna": {
      "kind": "bunny",
      "name": "Luna",
      "color": "#f4eaff",
      "pill": "#9a7fd1",
