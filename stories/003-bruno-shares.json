  "beats": [
    {
      "speaker": "narrator",
      "text": "Bruno the bear picked a whole basket of juicy berries.",
      "cam": {
        "follow": [
          "bruno"
        ],
        "zoom": 1.35
      },
      "act": {
        "bruno": {
          "expr": "happy"
        }
      }
    },
    {
      "speaker": "bruno",
      "text": "Mmm! All of these are mine!",
      "act": {
        "bruno": {
          "expr": "excited",
          "pose": "bounce"
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "Then Fen the fox came by. His tummy was rumbling.",
      "cam": {
        "follow": [
          "bruno",
          "fen"
        ],
        "zoom": 1.1
      },
      "act": {
        "bruno": {
          "pose": "idle",
          "expr": "happy"
        },
        "fen": {
          "move": "walk",
          "to": 790,
          "expr": "sad"
        }
      }
    },
    {
      "speaker": "fen",
      "text": "I couldn't find a single berry today...",
      "cam": {
        "follow": [
          "fen"
        ],
        "zoom": 1.35
      },
      "act": {
        "fen": {
          "look": "down"
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "Bruno looked at his berries. Then he looked at his friend.",
      "cam": {
        "follow": [
          "bruno"
        ],
        "zoom": 1.35
      },
      "act": {
        "bruno": {
          "expr": "worried",
          "look": "down"
        }
      }
    },
    {
      "speaker": "bruno",
      "text": "Here, Fen. Let's share!",
      "cam": {
        "follow": [
          "bruno",
          "fen"
        ],
        "zoom": 1.1
      },
      "act": {
        "bruno": {
          "expr": "happy",
          "look": "ahead"
        }
      },
      "props": {
        "b2": {
          "show": true,
          "to": 660,
          "during": [
            0.15,
            0.9
          ]
        },
        "b1": {
          "full": 0.5,
          "during": [
            0.15,
            0.5
          ]
        }
      }
    },
    {
      "speaker": "fen",
      "text": "Really? Thank you, Bruno!",
      "sfx": [
        {
          "name": "sparkle",
          "at": 0.05
        }
      ],
      "act": {
        "fen": {
          "expr": "excited",
          "pose": "cheer",
          "look": "ahead"
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "Bruno had fewer berries now. But his heart felt fuller than ever.",
      "cam": {
        "follow": [
          "bruno"
        ],
        "zoom": 1.3
      },
      "act": {
        "fen": {
          "pose": "idle",
          "expr": "happy"
        },
        "bruno": {
          "expr": "happy"
        }
      }
    },
    {
      "speaker": "bruno",
      "text": "Sharing makes me happy too!",
      "sfx": [
        {
          "name": "sparkle",
          "at": 0.05
        }
      ],
      "act": {
        "bruno": {
          "expr": "excited",
          "pose": "cheer"
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "The more you give, the more joy you find.",
      "cam": {
        "follow": [
          "bruno",
          "fen"
        ],
        "zoom": 1.05
