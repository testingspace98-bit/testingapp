  "beats": [
    {
      "speaker": "narrator",
      "text": "Every morning, Luna carried seeds across the meadow to Grandpa Bruno's garden.",
      "cam": {
        "follow": [
          "luna"
        ],
        "zoom": 1.2
      },
      "act": {
        "luna": {
          "expr": "happy",
          "move": "walk",
          "to": 820,
          "during": [
            0.1,
            1.0
          ]
        }
      },
      "props": {
        "basket": {
          "full": 0.4,
          "during": [
            0.1,
            1.0
          ]
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "But her basket had a little hole. And along the way, seeds always fell out.",
      "cam": {
        "follow": [
          "luna"
        ],
        "zoom": 1.35
      },
      "act": {
        "luna": {
          "expr": "worried",
          "look": "down"
        }
      }
    },
    {
      "speaker": "luna",
      "text": "Oh no. I lost half the seeds again. I'm so clumsy.",
      "act": {
        "luna": {
          "expr": "sad"
        }
      }
    },
    {
      "speaker": "luna",
      "text": "Grandpa Bruno, I'm sorry. I'm just not good enough.",
      "cam": {
        "follow": [
          "luna",
          "bruno"
        ],
        "zoom": 1.1
      },
      "act": {
        "bruno": {
          "expr": "happy",
          "move": "walk",
          "to": 1010,
          "during": [
            0.0,
            0.7
          ]
        },
        "luna": {
          "look": "ahead"
        }
      }
    },
    {
      "speaker": "bruno",
      "text": "Shh, little one. Wait, and I'll show you something.",
      "tempo": 0.95
    },
    {
      "speaker": "narrator",
      "text": "Weeks went by. Then one bright morning, they walked the path together.",
