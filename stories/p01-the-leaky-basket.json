    },
    {
      "speaker": "narrator",
      "text": "All along Luna's path, beautiful flowers had grown!",
      "sfx": [
        {
          "name": "sparkle",
          "at": 0.05
        }
      ],
      "act": {
        "luna": {
          "expr": "excited",
          "pose": "cheer",
          "look": "down"
        }
      }
    },
    {
      "speaker": "bruno",
      "text": "Your falling seeds did this. Your weakness made the whole path beautiful.",
      "tempo": 0.95,
      "cam": {
        "follow": [
          "bruno"
        ],
        "zoom": 1.3
      },
      "act": {
        "luna": {
          "pose": "idle",
          "look": "ahead"
        }
      }
    },
    {
      "speaker": "luna",
      "text": "So even my mistakes can bring something good?",
      "cam": {
        "follow": [
          "luna"
        ],
        "zoom": 1.3
      },
      "act": {
        "luna": {
          "expr": "happy"
        }
      }
    },
    {
      "speaker": "bruno",
      "text": "Yes. We all have cracks. But love can grow something beautiful from every one of them.",
      "tempo": 0.95,
      "cam": {
        "follow": [
          "luna",
          "bruno"
        ],
        "zoom": 1.15
      }
    },
    {
      "speaker": "narrator",
      "text": "Don't hide your cracks. Something beautiful may be growing from them.",
      "cam": {
        "follow": [
          "luna",
          "bruno"
        ],
        "zoom": 1.0
      }
    }
