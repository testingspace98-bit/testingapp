  "beats": [
    {
      "speaker": "narrator",
      "text": "Fen the fox tripped on a root and hurt his paw.",
      "cam": {
        "follow": [
          "fen"
        ],
        "zoom": 1.4
      },
      "act": {
        "fen": {
          "expr": "sad"
        }
      }
    },
    {
      "speaker": "fen",
      "text": "Ouch! Can anyone help me, please?"
    },
    {
      "speaker": "narrator",
      "text": "Bo flew by. But he was in a big hurry.",
      "cam": {
        "follow": [
          "fen"
        ],
        "zoom": 1.1
      },
      "act": {
        "bo": {
          "move": "fly",
          "to": [
            640,
            980
          ],
          "during": [
            0.0,
            1.0
          ]
        },
        "fen": {
          "look": "up"
        }
      }
    },
    {
      "speaker": "bo",
      "text": "Sorry, Fen! I'm too busy today!",
      "act": {
        "bo": {
          "move": "fly",
          "to": [
            1350,
            760
          ],
          "during": [
            0.1,
            1.0
          ]
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "Then came Bruno, the big bear. Everyone thought he was scary.",
      "cam": {
        "follow": [
          "fen",
          "bruno"
        ],
        "zoom": 1.05
      },
      "act": {
        "bruno": {
          "move": "walk",
          "to": 320,
          "during": [
            0.0,
            0.9
          ],
          "expr": "happy"
        },
        "fen": {
          "look": "ahead",
          "expr": "scared",
          "pose": "shiver"
        }
      }
    },
    {
      "speaker": "fen",
      "text": "Oh no... Please don't hurt me!",
      "cam": {
        "follow": [
          "fen"
        ],
        "zoom": 1.35
      }
    },
    {
      "speaker": "bruno",
      "text": "Hurt you? No, little friend. I'm here to help.",
      "cam": {
        "follow": [
          "bruno"
        ],
        "zoom": 1.35
      },
      "act": {
        "fen": {
          "pose": "crouch",
          "expr": "worried"
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "Bruno wrapped Fen's paw, and helped him all the way home.",
      "cam": {
        "follow": [
          "fen",
          "bruno"
        ],
        "zoom": 1.1
      },
      "act": {
        "fen": {
          "pose": "idle",
          "expr": "happy",
          "move": "walk",
          "to": 900,
          "during": [
            0.2,
            1.0
          ]
        },
        "bruno": {
          "move": "walk",
          "to": 640,
          "during": [
            0.15,
            1.0
          ]
        }
      }
    },
    {
      "speaker": "fen",
      "text": "Thank you, Bruno! You're the kindest friend ever!",
      "sfx": [
        {
          "name": "sparkle",
          "at": 0.05
        }
      ],
      "cam": {
        "follow": [
          "fen",
          "bruno"
        ],
        "zoom": 1.2
      },
      "act": {
        "fen": {
          "face": -1,
          "expr": "excited",
          "pose": "cheer"
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "Never judge someone by how they look. And always stop to help.",
      "act": {
        "fen": {
          "pose": "idle",
          "expr": "happy"
        }
      }
    }
  ],
  "outro": {
    "headline": "Stop and help someone today.",
